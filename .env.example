# ---------------------------------------------------------------------------
# Models. Everything here is optional: with no model server reachable the agent
# falls back to lexical scoring, escalates more, and still completes a run.
#
# Chat and embeddings are configured separately on purpose. A llama.cpp server
# usually hosts one chat model and no embedding model, so the common setup is a
# big chat model on one host and nomic-embed-text on Ollama somewhere else.
# ---------------------------------------------------------------------------

# "ollama" (native /api) or "openai" (OpenAI-compatible: llama.cpp, vLLM, LM Studio)
REASONING_PROVIDER=ollama
REASONING_BASE_URL=http://localhost:11434
REASONING_MODEL=gemma4:latest
# REASONING_API_KEY=not-needed-for-local

# Example: gemma 12B served by llama.cpp on a mac mini. llama.cpp speaks the
# OpenAI-compatible API, so provider is "openai" and the base URL ends in /v1.
# REASONING_PROVIDER=openai
# REASONING_BASE_URL=http://singireddys-mac-mini.local:8080/v1
# REASONING_MODEL=gemma-4-12B-it-Q4_K_M

# Embeddings usually stay on Ollama even when chat moves to llama.cpp, because a
# llama.cpp server hosting a chat model has no embedding model loaded.

EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Mock target system. Failure injection is deterministic so demos reproduce.
# ---------------------------------------------------------------------------
TARGET_FAIL_CODES=E1015,E1031
TARGET_REJECT_CODES=E1021
