# Keep the build context small and the image free of local state.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.idea/
.vscode/
.DS_Store

# Node: reinstalled inside the builder, and a host build is the wrong platform.
web/node_modules/
web/dist/
*.tsbuildinfo

# Local runtime state and secrets — never bake these in.
*.db
*.db-shm
*.db-wal
uploads/
.env
.env.local

# Not needed at runtime.
tests/
docs/
*.pdf
